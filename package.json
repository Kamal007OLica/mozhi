{
  "name": "mozhi",
  "private": true,
  "description": "Mozhi · மொழி — open-source, on-device Tamil voice typing.",
  "license": "Apache-2.0",
  "workspaces": ["apps/desktop", "apps/web"],
  "scripts": {
    "brand": "python3 brand/scripts/generate.py --png",
    "desktop:dev": "npm run tauri dev --workspace apps/desktop",
    "desktop:build": "npm run tauri build --workspace apps/desktop",
    "web:dev": "npm run dev --workspace apps/web",
    "web:build": "npm run build --workspace apps/web"
  }
}
